#!/bin/sh
# Runs the test suite before pushing to main. Enable once per clone with:
#   git config core.hooksPath .githooks
# Skip in an emergency with: git push --no-verify

pushes_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && pushes_main=1
done

[ "$pushes_main" -eq 0 ] && exit 0

echo "pre-push: running tests before pushing to main..."
npm --prefix backend test --silent >/dev/null 2>&1 || { echo "pre-push: BACKEND TESTS FAILED (run 'npm --prefix backend test')"; exit 1; }
npm --prefix frontend test --silent >/dev/null 2>&1 || { echo "pre-push: FRONTEND TESTS FAILED (run 'npm --prefix frontend test')"; exit 1; }
echo "pre-push: all tests passed"
